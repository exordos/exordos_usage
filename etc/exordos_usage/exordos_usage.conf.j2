[db]
connection_url = {{ DB_CONNECTION_URL }}

[victoria]
endpoint = {{ VICTORIA_ENDPOINT }}
username = {{ VICTORIA_USERNAME }}
password = {{ VICTORIA_PASSWORD }}

[ecosystem]
endpoint = {{ ECOSYSTEM_ENDPOINT }}
core_endpoint = http://core.local.genesis-core.tech/api/core
# Existing service user with an unscoped exordos_ecosystem.realm.read grant.
username = {{ ECOSYSTEM_USERNAME }}
password = {{ ECOSYSTEM_PASSWORD }}
# Empty means the central host realm, matching ecosystem's host_realm = NULL.
host_realm =

[worker]
window_seconds = 300
delay_seconds = 120
gap_seconds = 45
poll_seconds = 60
[recovery]
lookback_days = 7

[logging]
config = logging.yaml

[iam]
iam_endpoint = {{ IAM_ENDPOINT }}
audience = {{ IAM_AUDIENCE }}
hs256_jwks_decryption_key = {{ JWKS_KEY }}

[user_api]
bind_host = 0.0.0.0
bind_port = 8080
workers = 2

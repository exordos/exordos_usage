[Unit]
Description=Exordos Usage Nightly Recovery
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/exordos_usage/exordos_usage.conf

[Service]
Type=oneshot
ExecStart=/usr/bin/exordos-usage-recovery --config-file /etc/exordos_usage/exordos_usage.conf --config-dir /etc/exordos_usage/exordos_usage.d
TimeoutStartSec=infinity
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
